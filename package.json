{
  "name": "hibe-challenge",
  "version": "1.0.0",
  "description": "Hibe backend challenge - Node + TypeScript + Express + Drizzle ORM + sqlite3 (Node 22 compatible)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.29.4",
    "express": "^4.18.2",
    "p-limit": "^3.1.0",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  }
}
